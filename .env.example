# Copy to .env and fill in from the Supabase dashboard
# (Project Settings → API). The publishable key is safe to expose in the
# browser bundle — RLS decides what it can actually reach. Never use the
# service_role key in front-end code.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Where the staff dashboard lives. Generate both lines with:
#   node scripts/admin-path-hash.mjs your-admin-path
#
# Only the hash ships — the production build matches the digest of the URL the
# visitor typed, so the path itself is not in the bundle or in this repo. That
# keeps the dashboard out of casual sight; the actual lock is Supabase Auth and
# the is_staff() RLS policies. VITE_ADMIN_PATH is a dev-only convenience for
# `vite --host` over plain HTTP, where crypto.subtle is unavailable.
VITE_ADMIN_PATH=/your-admin-path
VITE_ADMIN_PATH_HASH=<64-char sha256 hex>

# VITE_SITE_ORIGIN is no longer read. The site's public address is a constant in
# src/lib/seoConfig.js — edit it there.
#
# It used to be configurable here, and that is exactly how the share image broke
# twice: Vercel's environment still has VITE_SITE_ORIGIN set to a hostname that
# 404s, and because the env var outranked the value in the source file, fixing
# the source changed the local build and nothing about the deployed one. If that
# variable is still set in the Vercel dashboard it is now inert, and deleting it
# will save the next person the confusion.

